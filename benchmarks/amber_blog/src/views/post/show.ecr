<h1>Post</h1>

<dl>
  <dt>UserId</dt>
  <dd><%= @post.user_id %></dd>
  <dt>CategoryId</dt>
  <dd><%= @post.category_id %></dd>
  <dt>Title</dt>
  <dd><%= @post.title %></dd>
  <dt>Slug</dt>
  <dd><%= @post.slug %></dd>
  <dt>Body</dt>
  <dd><%= @post.body %></dd>
  <dt>Published</dt>
  <dd><%= @post.published %></dd>
  <dt>PublishedAt</dt>
  <dd><%= @post.published_at %></dd>
</dl>

<a href="/posts">Back</a>
<a href="/posts/<%= @post.id %>/edit">Edit</a>
