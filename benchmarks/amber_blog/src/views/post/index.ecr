<h1>Posts</h1>

<a href="/posts/new">New Post</a>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>UserId</th>
      <th>CategoryId</th>
      <th>Title</th>
      <th>Slug</th>
      <th>Body</th>
      <th>Published</th>
      <th>PublishedAt</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><%= post.id %></td>
        <td><%= post.user_id %></td>
        <td><%= post.category_id %></td>
        <td><%= post.title %></td>
        <td><%= post.slug %></td>
        <td><%= post.body %></td>
        <td><%= post.published %></td>
        <td><%= post.published_at %></td>
        <td>
          <a href="/posts/<%= post.id %>">Show</a>
          <a href="/posts/<%= post.id %>/edit">Edit</a>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
