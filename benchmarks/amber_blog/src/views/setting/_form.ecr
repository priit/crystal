<% unless @errors.empty? %>
  <div class="form-errors" role="alert">
    <p>Please correct the following:</p>
    <ul>
      <% @errors.each do |error| %>
        <li><%= error.field %>: <%= error.message || "is invalid" %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<form action="<%= @setting.persisted? ? "/settings/#{@setting.id}" : "/settings" %>" method="POST">
  <%= csrf_tag %>
  <% if @setting.persisted? %>
    <%= hidden_field("_method", "PATCH") %>
  <% end %>
  <div class="form-group">
    <%= label("key") %>
    <%= text_field("key", value: @setting.key?) %>
  </div>
  <div class="form-group">
    <%= label("value") %>
    <%= text_area("value", value: @setting.value?) %>
  </div>
  <%= submit_button("Save") %>
</form>
