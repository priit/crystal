<% unless @errors.empty? %>
  <div class="form-errors" role="alert">
    <p>Please correct the following:</p>
    <ul>
      <% @errors.each do |error| %>
        <li><%= error.field %>: <%= error.message || "is invalid" %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<form action="<%= @subscriber.persisted? ? "/subscribers/#{@subscriber.id}" : "/subscribers" %>" method="POST">
  <%= csrf_tag %>
  <% if @subscriber.persisted? %>
    <%= hidden_field("_method", "PATCH") %>
  <% end %>
  <div class="form-group">
    <%= label("email") %>
    <%= email_field("email", value: @subscriber.email?) %>
  </div>
  <div class="form-group">
    <%= checkbox("confirmed", checked: @subscriber.confirmed? || false, value: "true") %>
    <%= label("confirmed") %>
  </div>
  <%= submit_button("Save") %>
</form>
