<h1>Categories</h1>

<a href="/categories/new">New Category</a>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Slug</th>
      <th>Description</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.id %></td>
        <td><%= category.name %></td>
        <td><%= category.slug %></td>
        <td><%= category.description %></td>
        <td>
          <a href="/categories/<%= category.id %>">Show</a>
          <a href="/categories/<%= category.id %>/edit">Edit</a>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
