<h1>Users</h1>

<a href="/users/new">New User</a>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Email</th>
      <th>Bio</th>
      <th>Admin</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.bio %></td>
        <td><%= user.admin %></td>
        <td>
          <a href="/users/<%= user.id %>">Show</a>
          <a href="/users/<%= user.id %>/edit">Edit</a>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
