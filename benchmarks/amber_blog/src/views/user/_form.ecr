<% unless @errors.empty? %>
  <div class="form-errors" role="alert">
    <p>Please correct the following:</p>
    <ul>
      <% @errors.each do |error| %>
        <li><%= error.field %>: <%= error.message || "is invalid" %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<form action="<%= @user.persisted? ? "/users/#{@user.id}" : "/users" %>" method="POST">
  <%= csrf_tag %>
  <% if @user.persisted? %>
    <%= hidden_field("_method", "PATCH") %>
  <% end %>
  <div class="form-group">
    <%= label("name") %>
    <%= text_field("name", value: @user.name?) %>
  </div>
  <div class="form-group">
    <%= label("email") %>
    <%= email_field("email", value: @user.email?) %>
  </div>
  <div class="form-group">
    <%= label("bio") %>
    <%= text_area("bio", value: @user.bio?) %>
  </div>
  <div class="form-group">
    <%= checkbox("admin", checked: @user.admin? || false, value: "true") %>
    <%= label("admin") %>
  </div>
  <%= submit_button("Save") %>
</form>
