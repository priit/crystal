<% unless @errors.empty? %>
  <div class="form-errors" role="alert">
    <p>Please correct the following:</p>
    <ul>
      <% @errors.each do |error| %>
        <li><%= error.field %>: <%= error.message || "is invalid" %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<form action="<%= @page.persisted? ? "/pages/#{@page.id}" : "/pages" %>" method="POST">
  <%= csrf_tag %>
  <% if @page.persisted? %>
    <%= hidden_field("_method", "PATCH") %>
  <% end %>
  <div class="form-group">
    <%= label("title") %>
    <%= text_field("title", value: @page.title?) %>
  </div>
  <div class="form-group">
    <%= label("slug") %>
    <%= text_field("slug", value: @page.slug?) %>
  </div>
  <div class="form-group">
    <%= label("body") %>
    <%= text_area("body", value: @page.body?) %>
  </div>
  <div class="form-group">
    <%= label("position") %>
    <%= number_field("position", value: @page.position?) %>
  </div>
  <%= submit_button("Save") %>
</form>
